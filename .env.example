# Copy to .env for local development. Never commit real values.
# These are the only variables the browser bundle needs; all of them are public
# by design (the publishable key is safe to ship to clients).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-side only. Provided by the hosting platform's encrypted secret store —
# never place real values in a file that is committed.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
# LOVABLE_API_KEY=
